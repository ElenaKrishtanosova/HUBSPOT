{
  "database_name": "HubSpot CRM",
  "schema_version": "3.0",
  "description": "Simplified schema optimized for business insights generation and incremental data insertion",
  "tables": {
    "companies": {
      "description": "Company information and details",
      "columns": {
        "company_domain": {"type": "TEXT", "constraint": "PRIMARY KEY"},
        "name": {"type": "TEXT", "constraint": "NOT NULL"},
        "industry": {
          "type": "TEXT", 
          "constraint": "CHECK (industry IN ('Retail', 'Wholesale', 'Manufacturing', 'Distribution'))"
        }
      }
    },
    "contacts": {
      "description": "Contact person information",
      "columns": {
        "contact_email": {"type": "TEXT", "constraint": "PRIMARY KEY"},
        "first_name": {"type": "TEXT"},
        "last_name": {"type": "TEXT"},
        "company_domain": {"type": "TEXT", "constraint": "FK → companies.company_domain"}
      }
    },
    "deals": {
      "description": "Sales deals and opportunities",
      "columns": {
        "deal_id": {"type": "BIGSERIAL", "constraint": "PRIMARY KEY"},
        "deal_name": {"type": "TEXT", "constraint": "NOT NULL"},
        "deal_stage": {
          "type": "TEXT", 
          "constraint": "CHECK (deal_stage IN ('Appointment Scheduled', 'Qualified to Buy', 'Presentation Scheduled', 'Closed Won', 'Closed Lost'))"
        },
        "description": {"type": "TEXT"},
        "contact_email": {"type": "TEXT", "constraint": "FK → contacts.contact_email"},
        "company_domain": {"type": "TEXT", "constraint": "FK → companies.company_domain"},
        "activity_date": {"type": "TEXT"}
      }
    },
    "tickets": {
      "description": "Support tickets and issues",
      "columns": {
        "ticket_id": {"type": "BIGSERIAL", "constraint": "PRIMARY KEY"},
        "ticket_name": {"type": "TEXT", "constraint": "NOT NULL"},
        "priority": {
          "type": "TEXT", 
          "constraint": "CHECK (priority IN ('Low', 'Medium', 'High'))"
        },
        "issue_of_interest": {
          "type": "TEXT", 
          "constraint": "CHECK (issue_of_interest IN ('Crumb tray', 'Overheating', 'Wi‑Fi setup', 'Shipping delay', 'Thermostat', 'Packaging', 'Noise', 'Invoice'))"
        },
        "description": {"type": "TEXT"},
        "contact_email": {"type": "TEXT", "constraint": "FK → contacts.contact_email"},
        "company_domain": {"type": "TEXT", "constraint": "FK → companies.company_domain"},
        "ticket_owner": {"type": "TEXT", "constraint": "FK → users.email"},
        "activity_date": {"type": "TEXT"}
      }
    },
    "products": {
      "description": "Product catalog information",
      "columns": {
        "product_id": {"type": "BIGSERIAL", "constraint": "PRIMARY KEY"},
        "name": {"type": "TEXT", "constraint": "NOT NULL UNIQUE"},
        "description": {"type": "TEXT"},
        "price": {"type": "NUMERIC(18,2)"}
      }
    },
    "users": {
      "description": "System users and owners",
      "columns": {
        "user_id": {"type": "BIGSERIAL", "constraint": "PRIMARY KEY"},
        "email": {"type": "TEXT", "constraint": "NOT NULL UNIQUE"},
        "full_name": {"type": "TEXT"}
      }
    },
    "tasks": {
      "description": "Task management and assignments",
      "columns": {
        "task_id": {"type": "BIGSERIAL", "constraint": "PRIMARY KEY"},
        "title": {"type": "TEXT", "constraint": "NOT NULL"},
        "notes": {"type": "TEXT"},
        "assigned_to_user_id": {"type": "BIGINT", "constraint": "FK → users.user_id"},
        "deal_id": {"type": "BIGINT", "constraint": "FK → deals.deal_id"}
      }
    },
    "calls": {
      "description": "Call records and communications",
      "columns": {
        "call_id": {"type": "BIGSERIAL", "constraint": "PRIMARY KEY"},
        "notes": {"type": "TEXT"},
        "direction": {"type": "TEXT", "values": ["Inbound", "Outbound"]},
        "assigned_to_user_id": {"type": "BIGINT", "constraint": "FK → users.user_id"},
        "contact_email": {"type": "TEXT", "constraint": "FK → contacts.contact_email"},
        "activity_at": {"type": "TIMESTAMPTZ"}
      }
    },
    "emails": {
      "description": "Email communications",
      "columns": {
        "email_id": {"type": "BIGSERIAL", "constraint": "PRIMARY KEY"},
        "body": {"type": "TEXT"},
        "subject": {"type": "TEXT"},
        "contact_email": {"type": "TEXT", "constraint": "FK → contacts.contact_email"},
        "direction": {"type": "TEXT", "values": ["Incoming", "Outgoing"]},
        "created_at": {"type": "TIMESTAMPTZ"}
      }
    },
    "notes": {
      "description": "General notes and documentation",
      "columns": {
        "note_id": {"type": "BIGSERIAL", "constraint": "PRIMARY KEY"},
        "body": {"type": "TEXT", "constraint": "NOT NULL"},
        "activity_assigned_to_user_id": {"type": "BIGINT", "constraint": "FK → users.user_id"},
        "contact_email": {"type": "TEXT", "constraint": "FK → contacts.contact_email"},
        "deal_id": {"type": "BIGINT", "constraint": "FK → deals.deal_id"},
        "ticket_id": {"type": "BIGINT", "constraint": "FK → tickets.ticket_id"},
        "activity_date": {"type": "DATE"}
      }
    },
    "deal_line_items": {
      "description": "Line items within deals",
      "columns": {
        "deal_id": {"type": "BIGINT", "constraint": "FK → deals.deal_id ON DELETE CASCADE"},
        "product_id": {"type": "BIGINT", "constraint": "FK → products.product_id"},
        "quantity": {"type": "INTEGER", "constraint": "NOT NULL DEFAULT 1"},
        "unit_price": {"type": "NUMERIC(18,2)"}
      }
    }
  },
  "associations": {
    "company_contact_associations": {
      "description": "Many-to-many company-contact relationships",
      "columns": {
        "company_domain": {"type": "TEXT", "constraint": "FK → companies.company_domain ON DELETE CASCADE"},
        "contact_email": {"type": "TEXT", "constraint": "FK → contacts.contact_email ON DELETE CASCADE"}
      },
      "primary_key": ["company_domain", "contact_email"]
    },
    "deal_company_associations": {
      "description": "Many-to-many deal-company relationships",
      "columns": {
        "deal_id": {"type": "BIGINT", "constraint": "FK → deals.deal_id ON DELETE CASCADE"},
        "company_domain": {"type": "TEXT", "constraint": "FK → companies.company_domain ON DELETE CASCADE"}
      },
      "primary_key": ["deal_id", "company_domain"]
    }
  },
  "key_changes": {
    "schema_simplification": {
      "removed_fields": ["Vector embeddings", "Complex constraints", "Unnecessary fields"],
      "simplified_associations": "Removed labels and complex relationships",
      "focus": "Essential fields for business insights generation"
    },
    "id_field_updates": {
      "all_primary_keys": "BIGSERIAL for auto-increment functionality",
      "foreign_keys": "Updated to reference BIGSERIAL fields",
      "benefits": "Enables incremental data insertion without ID conflicts"
    },
    "field_consolidation": {
      "companies": "Simplified to essential fields (domain, name, industry)",
      "contacts": "Streamlined structure with email as primary key",
      "deals_tickets": "Focus on core business fields",
      "activities": "Essential tracking fields only"
    }
  },
  "constraints": {
    "enumerated_values": {
      "industry": ["Retail", "Wholesale", "Manufacturing", "Distribution"],
      "deal_stage": ["Appointment Scheduled", "Qualified to Buy", "Presentation Scheduled", "Closed Won", "Closed Lost"],
      "priority": ["Low", "Medium", "High"],
      "issue_of_interest": ["Crumb tray", "Overheating", "Wi‑Fi setup", "Shipping delay", "Thermostat", "Packaging", "Noise", "Invoice"]
    }
  },
  "use_case_optimization": {
    "business_insights": "Schema designed for pattern detection",
    "incremental_data": "Support for adding historical data",
    "performance": "Simplified structure for faster queries",
    "maintenance": "Easier to manage and update"
  }
}